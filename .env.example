# ── Admin panel ──────────────────────────────────────────────
# Password that guards http://<yoursite>/admin
ADMIN_PASSWORD=change-me

# ── Optional: save content by committing to GitHub ───────────
# When both are set, the admin commits content/media to your repo
# (works on Vercel/Netlify — the push triggers a redeploy).
# GITHUB_TOKEN and GITHUB_REPO are ignored on this form if GITHUB_REPO is set.
# Fine-grained PAT with "Contents" read+write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=yourname/yourrepo

# ── Optional: max media upload size (bytes) ───────────────────
# Default is 200 MB (209715200). Lower it if you want, e.g. 52428800 = 50 MB.
# MAX_MEDIA_BYTES=209715200

# ── Optional: your live site URL (no trailing slash) ─────────
# Used for SEO — canonical link, sitemap, Open Graph. Falls back to
# https://jaheasy.example.com if unset. Set this to your real domain
# (e.g. https://jaheasy.com) once the site is live.
NEXT_PUBLIC_SITE_URL=
